<Window x:Class="ClientUNO.PlayerProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClientUNO"
        Title="Player Profile"
        Height="480"
        Width="700">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                       CornerRadius="25"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>


    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Верхняя часть -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Аватар -->
            <Border Width="150"
                Height="150"
                CornerRadius="20"
                BorderBrush="Black"
                BorderThickness="2">

                <Image x:Name="avatar"
                   Stretch="UniformToFill"/>

            </Border>


            <!-- Имя и статус -->
            <StackPanel Grid.Column="1"
                    Margin="30,10,0,0">

                <TextBlock x:Name="username"
                       FontSize="30"
                       FontWeight="Bold"
                       FontFamily="Comic Sans MS"
                       Foreground="SaddleBrown"/>


                <TextBlock x:Name="status"
                       FontSize="18"
                       Margin="0,15,0,0"
                       FontFamily="Comic Sans MS"
                       TextWrapping="Wrap"
                       MaxWidth="350"/>

            </StackPanel>

        </Grid>



        <!-- Статистика -->
        <StackPanel Grid.Row="1"
                Margin="0,40,0,0">


            <!-- Место в рейтинге -->
            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Rating place:"
                       FontSize="20"
                       FontFamily="Comic Sans MS"
                       Foreground="SaddleBrown"/>

                <TextBlock x:Name="rating"
                       FontSize="20"
                       Margin="20,0,0,0"
                       FontWeight="Bold"/>

            </StackPanel>



            <!-- Победы -->
            <StackPanel Orientation="Horizontal"
                    Margin="0,15,0,0">

                <TextBlock Text="Victories:"
                       FontSize="20"
                       FontFamily="Comic Sans MS"
                       Foreground="SaddleBrown"/>

                <TextBlock x:Name="wins"
                       FontSize="20"
                       Margin="20,0,0,0"
                       FontWeight="Bold"/>

            </StackPanel>



            <!-- Очки -->
            <StackPanel Orientation="Horizontal"
                    Margin="0,15,0,0">

                <TextBlock Text="Points:"
                       FontSize="20"
                       FontFamily="Comic Sans MS"
                       Foreground="SaddleBrown"/>

                <TextBlock x:Name="points"
                       FontSize="20"
                       Margin="20,0,0,0"
                       FontWeight="Bold"/>

            </StackPanel>


        </StackPanel>
        <Button Content="Close"
        Width="268"
        Height="48"
        FontSize="22"
        FontFamily="Comic Sans MS"
        Foreground="#6F4E37"
        Background="White"
        Opacity="0.7"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,182,0,0"
        Click="Close_Click" Grid.Row="1"/>
    </Grid>

</Window>