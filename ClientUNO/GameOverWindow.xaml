<Window x:Class="ClientUNO.GameOverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Over"
        Width="950"
        Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        

        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>


    <Grid Margin="30">


        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>


        <!-- Заголовок -->

        <TextBlock Grid.Row="0"
                   Text="Game is over"
                   FontSize="40"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="-2,20,0,0"/>

        <TextBlock Grid.Row="0"
                   Text="Game is over"
                   FontSize="40"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="2,20,0,0"/>

        <TextBlock Grid.Row="0"
                   Text="Game is over"
                   FontSize="40"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="SaddleBrown"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,0"/>



        <!-- Игроки -->

        <Border Grid.Row="1"
                Background="White"
                Opacity="0.75"
                CornerRadius="20"
                Padding="20">

            <ItemsControl ItemsSource="{Binding Players}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="190"
                                Height="300"
                                Margin="15"
                                Background="White"
                                CornerRadius="20"
                                BorderBrush="SaddleBrown"
                                BorderThickness="2">


                            <Grid Margin="15">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="130"/>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="45"/>
                                </Grid.RowDefinitions>


                                <!-- Аватар -->
                                <TextBlock Grid.Row="0"
                                   Text="🏆 WINNER 🏆"
                                   FontSize="20"
                                   FontFamily="Comic Sans MS"
                                   FontWeight="Bold"
                                   Foreground="Goldenrod"
                                   HorizontalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWinner}"
                                                        Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Image Grid.Row="1"
                                       Width="130"
                                       Height="130"
                                       HorizontalAlignment="Center"
                                       Source="{Binding AvatarId,
                                       Converter={StaticResource AvatarConverter}}"/>


                                <!-- Имя -->

                                <TextBlock Grid.Row="2"
                                           Text="{Binding Name}"
                                           FontSize="20"
                                           FontFamily="Comic Sans MS"
                                           Foreground="SaddleBrown"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>


                                <!-- Очки -->

                                <Border Grid.Row="3"
                                        Background="#F5E6D3"
                                        CornerRadius="15"
                                        Margin="20,5">

                                    <TextBlock Text="{Binding Points,
                                               StringFormat='Points: {0}'}"
                                               FontSize="17"
                                               FontFamily="Comic Sans MS"
                                               Foreground="Goldenrod"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/> 

                                </Border>


                            </Grid>

                        </Border>


                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>


        </Border>



        <!-- Кнопка -->

        <Button Grid.Row="2"
                Width="250"
                Height="45"
                Content="Back to lobby"
                FontSize="18"
                FontFamily="Comic Sans MS"
                Foreground="#6F4E37"
                Background="White"
                Opacity="0.8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="BackToLobby_Click"/>


    </Grid>


</Window>