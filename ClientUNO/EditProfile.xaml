<Window x:Class="ClientUNO.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientUNO"
        mc:Ignorable="d"
        Title="Profile"
        Height="430"
        Width="600">


    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>


    <Grid>


        <!-- Заголовок Profile -->
        <TextBlock Text="Profile"
                   FontSize="35"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="-2,15,0,0"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Profile"
                   FontSize="35"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="2,15,0,0"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Profile"
                   FontSize="35"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,13,0,0"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Profile"
                   FontSize="35"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,17,0,0"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Profile"
                   FontSize="35"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   Foreground="SaddleBrown"
                   Margin="0,15,0,0"
                   HorizontalAlignment="Center"/>



        <!-- Основная часть -->

        <Grid Margin="40,80,40,80">


            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



            <!-- Аватар -->

            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center">


                <Border Width="120"
                        Height="120"
                        CornerRadius="60"
                        BorderBrush="SaddleBrown"
                        BorderThickness="3"
                        Cursor="Hand"
                        MouseDown="Avatar_Click">


                    <Image x:Name="AvatarImage"
                           Stretch="UniformToFill"/>


                </Border>


                <TextBlock Text="Change avatar"
                           FontFamily="Comic Sans MS"
                           Foreground="SaddleBrown"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>


            </StackPanel>



            <!-- Имя и статус -->

            <StackPanel Grid.Column="1"
                        Margin="20,5,0,0">


                <TextBlock Text="Username"
                           FontFamily="Comic Sans MS"
                           Foreground="SaddleBrown"
                           FontSize="15"/>


                <TextBox x:Name="UsernameBox"
                         Height="30"
                         FontSize="15"
                         VerticalContentAlignment="Center"/>



                <TextBlock Text="Status"
                           FontFamily="Comic Sans MS"
                           Foreground="SaddleBrown"
                           FontSize="15"
                           Margin="0,15,0,0"/>


                <TextBox x:Name="StatusBox"
                         Height="75"
                         FontSize="14"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>


            </StackPanel>


        </Grid>



        <!-- Кнопки -->

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,25">


            <Button Content="Save"
                    Width="150"
                    Height="40"
                    FontSize="15"
                    Margin="20,10"
                    FontFamily="Comic Sans MS"
                    Foreground="#6F4E37"
                    Background="White"
                    Opacity="0.7"
                    Click="Save_Click"/>


            <Button Content="Exit"
                    Width="150"
                    Height="40"
                    FontSize="15"
                    Margin="20,10"
                    FontFamily="Comic Sans MS"
                    Foreground="#6F4E37"
                    Background="White"
                    Opacity="0.7"
                    Click="Exit_Click"/>


        </StackPanel>


    </Grid>

</Window>