<Window x:Class="ClientUNO.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNO Game" Height="700" Width="1100">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>

    <Grid>

        <!-- ================= TOP PLAYERS ================= -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="120">

            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                <Border Width="106" Height="104" CornerRadius="6" BorderThickness="5" BorderBrush="Gray"/>
                <TextBlock Text="Player 2" HorizontalAlignment="Center"/>
                <TextBlock Text="Cards: 5" HorizontalAlignment="Center"/>

                <Button Content="UNO"
                        Width="60"
                        Height="25"
                        Visibility="Hidden"/>
            </StackPanel>

        </Grid>

        <!-- ================= LEFT PLAYER ================= -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20">

            <Border Width="106" Height="104" CornerRadius="6" BorderThickness="5" BorderBrush="Gray"/>
            <TextBlock Text="Player 3"/>
            <TextBlock Text="Cards: 8"/>

            <Border Width="120" Height="160" BorderThickness="2" BorderBrush="Transparent"/>
        </StackPanel>

        <!-- ================= RIGHT PLAYER ================= -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20">

            <Border Width="106" Height="104" CornerRadius="6" BorderThickness="5" BorderBrush="Gray"/>
            <TextBlock Text="Player 4"/>
            <TextBlock Text="Cards: 3"/>

            <Border Width="120" Height="160" BorderThickness="2" BorderBrush="Transparent"/>
        </StackPanel>

        <!-- ================= CENTER GAME AREA ================= -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,212,0,0">

            <!-- Deck -->
            <Border Width="120" Height="160"
                    Background="Transparent"
                    BorderThickness="3"
                    BorderBrush="Black"
                    HorizontalAlignment="Left"
                    Margin="-160,0,0,0"/>

            <!-- Last card -->
            <Border Width="120" Height="160"
                    Background="Transparent"
                    BorderThickness="3"
                    BorderBrush="DarkRed"
                    HorizontalAlignment="Right"
                    Margin="0,0,-160,0"/>

        </Grid>

        <!-- ================= BOTTOM (MAIN PLAYER) ================= -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,20">

            <!-- player info -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="139" Height="139" CornerRadius="6" BorderThickness="5" BorderBrush="Gray"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="You"/>
                    <TextBlock Text="Cards: 6"/>
                </StackPanel>

                <Button Content="UNO"
                        Width="70"
                        Height="30"
                        Margin="20,0,0,0"
                        Visibility="Hidden"/>
            </StackPanel>

            <!-- cards hand -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="90"
                    Height="130"
                    BorderThickness="2"
                    BorderBrush="Black"
                    Margin="5">
                                <Image Source="{Binding ImagePath}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </StackPanel>

    </Grid>
</Window>