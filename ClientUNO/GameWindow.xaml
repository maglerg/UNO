<Window x:Class="ClientUNO.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Shared_Library;assembly=Shared_Library"
        Title="UNO Game" Height="700" Width="1100"
        xmlns:conv="clr-namespace:ClientUNO.Converters"
        xmlns:panels="clr-namespace:ClientUNO.Panels">

    <Window.Resources>
        <conv:CardToImageConverter x:Key="CardToImageConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>

    <Grid>

        <!-- ================= TOP PLAYERS ================= -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="120" Visibility="{Binding TopPlayerVisibility}">

            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                <Border Width="106" Height="104" CornerRadius="6" BorderThickness="5" BorderBrush="{Binding TopPlayerBorderColor}"/>
                <TextBlock Text="{Binding TopPlayer.Name}"
           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding TopPlayer.CardCount,
                          StringFormat=Cards: {0}}"
           HorizontalAlignment="Center"/>

                <Button Content="UNO"
        Command="{Binding UnoCommand}"
        CommandParameter="{Binding TopPlayer.Index}"
        Visibility="{Binding TopPlayerUnoVisibility}"/>
            </StackPanel>

        </Grid>

        <!-- ================= LEFT PLAYER ================= -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20" Visibility="{Binding LeftPlayerVisibility}">

            <Border Width="106" Height="104" CornerRadius="6" BorderThickness="5" BorderBrush="{Binding LeftPlayerBorderColor}"/>
            <TextBlock Text="{Binding LeftPlayer.Name}"/>

            <TextBlock Text="{Binding LeftPlayer.CardCount,
                          StringFormat=Cards: {0}}"/>

            <Button Content="UNO"
        Command="{Binding UnoCommand}"
        CommandParameter="{Binding LeftPlayer.Index}"
        Visibility="{Binding LeftPlayerUnoVisibility}"/>

            <Border Width="120" Height="160" BorderThickness="2" BorderBrush="Transparent"/>
        </StackPanel>

        <!-- ================= RIGHT PLAYER ================= -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20" Visibility="{Binding RightPlayerVisibility}">

            <Border Width="106" Height="104" CornerRadius="6" BorderThickness="5" BorderBrush="{Binding RightPlayerBorderColor}"/>
            <TextBlock Text="{Binding RightPlayer.Name}"/>

            <TextBlock Text="{Binding RightPlayer.CardCount,
                          StringFormat=Cards: {0}}"/>

            <Button Content="UNO"
        Command="{Binding UnoCommand}"
        CommandParameter="{Binding RightPlayer.Index}"
        Visibility="{Binding RightPlayerUnoVisibility}"/>

            <Border Width="120" Height="160" BorderThickness="2" BorderBrush="Transparent"/>
        </StackPanel>

        <!-- ================= CENTER GAME AREA ================= -->
        <Grid HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Margin="0,212,0,0">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <!-- Deck -->
                    <Button Width="120"
                     Height="160"
                     Command="{Binding DrawCardCommand}"
                     HorizontalAlignment="Left"
                     Margin="-160,0,0,0">

                        <Image Source="Images/back.png"/>
                    </Button>

                    <!-- Last card -->
                    <Border Width="120"
                     Height="160"
                     HorizontalAlignment="Right"
                     Margin="0,0,-160,0">

                        <Image Source="{Binding TopCard,
             Converter={StaticResource CardToImageConverter}}"/>
                    </Border>
                    <StackPanel HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,200,-160,0"
                     Width="160">

                        <Border Background="#AAFF4444"
                             CornerRadius="10"
                             Padding="8"
                             Visibility="{Binding ErrorVisibility}">

                            <TextBlock Text="{Binding ErrorMessage}"
                            Foreground="White"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                    <!-- Draw button -->
                    <Button Content="Взять карту"
                     Width="120"
                     Height="35"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-160,175,0,0"
                     Command="{Binding DrawCardCommand}"/>
                </StackPanel>
            </StackPanel>

           

        </Grid>
        
        <!-- ================= BOTTOM (MAIN PLAYER) ================= -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,10,10,20" Orientation="Horizontal">

            <!-- player info -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="139" Height="139" CornerRadius="6" BorderThickness="5" BorderBrush="{Binding MePlayerBorderColor}"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="{Binding Me.Name}"/>

                    <TextBlock Text="{Binding Me.CardCount,
                          StringFormat=Cards: {0}}"/>
                </StackPanel>

                <Button Content="UNO"
        Command="{Binding UnoCommand}"
        CommandParameter="{Binding Me.Index}"
        Visibility="{Binding MePlayerUnoVisibility}"/>
            </StackPanel>

            <!-- cards hand -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              Margin="10"
              Width="850">

                <ItemsControl ItemsSource="{Binding Cards}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <panels:HandPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Button Command="{Binding DataContext.PlayCardCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">

                                <Image Source="{Binding Converter={StaticResource CardToImageConverter}}"
                           Width="90"
                           Height="130"/>

                            </Button>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </StackPanel>
        <Grid x:Name="ColorOverlay"
          Background="#80000000"
          Visibility="{Binding ColorSelectionVisibility}">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Background="Red" Width="50" Height="50" Command="{Binding ChooseColorCommand}"
        CommandParameter="{x:Static local:ColorCard.Red}"/>
                <Button Background="Blue" Width="50" Height="50" Command="{Binding ChooseColorCommand}"
        CommandParameter="{x:Static local:ColorCard.Blue}"/>
                <Button Background="Green" Width="50" Height="50" Command="{Binding ChooseColorCommand}"
        CommandParameter="{x:Static local:ColorCard.Green}"/>
                <Button Background="Yellow" Width="50" Height="50" Command="{Binding ChooseColorCommand}"
        CommandParameter="{x:Static local:ColorCard.Yellow}"/>

            </StackPanel>
        </Grid>
        <Border Background="#80000000"
        CornerRadius="10"
        Padding="15"
        Visibility="{Binding NotificationVisibility}"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,180,0,0" Width="361">

            <TextBlock Text="{Binding NotificationText}"
               Foreground="White"
               FontSize="20"
               FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>

