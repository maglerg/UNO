<Window x:Class="ClientUNO.Lobby"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientUNO"
        mc:Ignorable="d"
        Title="Lobby" Height="700" Width="1100">

    <Window.Resources>
        <local:AvatarConverter x:Key="AvatarConverter"/>
        <local:PlayerColorConverter x:Key="PlayerColorConverter"/>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallRadiusButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>

    <Grid>
        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="-2,15,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="2,15,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,13,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,17,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="SaddleBrown"
               Margin="0,15,0,0"
               HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Margin="48,104,-48,-104">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Width="321" RenderTransformOrigin="0.5,0.5" Height="43">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0"/>
                            <RotateTransform/>
                            <TranslateTransform X="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Room code" FontSize="15"
FontFamily="Comic Sans MS" Foreground="SaddleBrown" Margin="10,10,5,10" TextAlignment="Center"/>
                    <TextBlock Width="114" Height="20" x:Name="roomcode" FontSize="15"
FontFamily="Comic Sans MS" TextAlignment="Center"/>
                    <Button Content="Copy" Width="69" Height="31" FontSize="15" Style="{StaticResource SmallRadiusButtonStyle}"
FontFamily="Comic Sans MS" Foreground="#6F4E37" Background="White" Opacity="0.7" Click="CopyRoomCode_Click"/>
                    <TextBlock Width="51" Height="31" FontSize="15" Margin="10,0,0,0" x:Name="roomcopy" Text="Сopied"
                               Visibility="Collapsed" FontFamily="Comic Sans MS" Background="White" Opacity="0.4"  Padding="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="514,104,53,41">

            <TextBlock Text="Players"
               FontSize="20"
               FontFamily="Comic Sans MS"
               Foreground="SaddleBrown"/>

            <ListBox ItemsSource="{Binding Players}"
             Width="523"
             Height="450"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
             MouseDoubleClick="PlayersList_MouseDoubleClick">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>


                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border CornerRadius="10"
                        Padding="10"
                        Margin="5"
                        Opacity="0.8">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Id, Converter={StaticResource PlayerColorConverter}}" 
                                             Value="True">
                                            <Setter Property="Background" Value="LightGreen"/>
                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal">

                                <Image Width="100"
                               Height="100"
                               Margin="0,0,15,0"
                               Source="{Binding AvatarId,
                               Converter={StaticResource AvatarConverter}}"/>

                                <TextBlock Text="{Binding Name}"
                                   FontSize="18"
                                   FontFamily="Comic Sans MS"
                                   Foreground="Black"
                                   VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </StackPanel>
        <Button Content="Start game"
                Visibility="Collapsed"
                x:Name="StartGame"
        Width="267"
        Height="48"
        FontSize="22"
        FontFamily="Comic Sans MS"
        Foreground="#6F4E37"
        Background="White"
        Opacity="0.7"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Click="StartGame_Click"
        Margin="48,185,0,0"/>

        <TextBlock x:Name="StartGameError"
               Foreground="Red"
               FontSize="12"
               Visibility="Collapsed"
               Margin="168,2,0,0"/>
        <Button Content="Leave game |->"
                Click="LeaveGame_Click"
Width="267"
Height="42"
FontSize="20"
FontFamily="Comic Sans MS"
Foreground="#6F4E37"
Background="White"
Opacity="0.7"
HorizontalAlignment="Left"
VerticalAlignment="Top"
Margin="48,265,0,0"/>

        <TextBlock x:Name="LeaveGameError"
       Foreground="Red"
       FontSize="12"
       Visibility="Collapsed"
       Margin="168,2,0,0"/>

    </Grid>
</Window>