<Window x:Class="ClientUNO.Lobby"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientUNO"
        mc:Ignorable="d"
        Title="Lobby" Height="700" Width="1100">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>

    <Grid>
        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="-2,15,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="2,15,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,13,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,17,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Lobby"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="SaddleBrown"
               Margin="0,15,0,0"
               HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Margin="48,104,-48,-104">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Width="321" RenderTransformOrigin="0.5,0.5" Height="43">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0"/>
                            <RotateTransform/>
                            <TranslateTransform X="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Room code" FontSize="15"
FontFamily="Comic Sans MS" Foreground="SaddleBrown" Margin="10" TextAlignment="Center"/>
                    <TextBlock Width="120" Height="20" Margin="10,0,0,0" x:Name="roomcode"/>
                    <Button Content="Copy" Width="69" Height="31" FontSize="15"
FontFamily="Comic Sans MS" Foreground="#6F4E37" Background="White" Opacity="0.7" Click="CopyRoomCode_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="514,104,53,41">
            <TextBlock Text="Players" FontSize="20"
FontFamily="Comic Sans MS" Foreground="SaddleBrown"/>
            <ListBox ItemsSource="{Binding Players}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="5"
                    Opacity="0.8">

                            <TextBlock Text="{Binding Name}"
                           FontSize="18"
                           FontFamily="Comic Sans MS"
                           Foreground="Black"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <Button Content="Start game"
        Width="267"
        Height="48"
        FontSize="22"
        FontFamily="Comic Sans MS"
        Foreground="#6F4E37"
        Background="White"
        Opacity="0.7"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="72,230,0,0"/>

        <TextBlock x:Name="StartGameError"
               Foreground="Red"
               FontSize="12"
               Visibility="Collapsed"
               Margin="168,2,0,0"/>
        <Button Content="Leave game |->"
                Click="LeaveGame_Click"
Width="267"
Height="42"
FontSize="20"
FontFamily="Comic Sans MS"
Foreground="#6F4E37"
Background="White"
Opacity="0.7"
HorizontalAlignment="Left"
VerticalAlignment="Top"
Margin="72,341,0,0"/>

        <TextBlock x:Name="LeaveGameError"
       Foreground="Red"
       FontSize="12"
       Visibility="Collapsed"
       Margin="168,2,0,0"/>

    </Grid>
</Window>