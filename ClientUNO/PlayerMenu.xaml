<Window x:Class="ClientUNO.PlayerMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientUNO"
        mc:Ignorable="d"
        Title="PlayerMenu" Height="700" Width="1100">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="25"
                            Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>

    <Grid>
        <TextBlock Text="Menu"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="-2,15,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Menu"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="2,15,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Menu"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,13,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Menu"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,17,0,0"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Menu"
               FontSize="55"
               FontFamily="Comic Sans MS"
               FontWeight="Bold"
               Foreground="SaddleBrown"
               Margin="0,15,0,579"
               HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Margin="37,110,51,160">

            <StackPanel Width="274" Height="484" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="0.173"/>
                        <RotateTransform/>
                        <TranslateTransform X="0.797"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <Border BorderBrush="Black"
        BorderThickness="2"
        Width="210"
        Height="198"
        CornerRadius="20"
        ClipToBounds="True">

                    <Image Source="{Binding MyAvatar}"
           Stretch="UniformToFill"/>

                </Border>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Number of victories" FontSize="15"
FontFamily="Comic Sans MS" Foreground="SaddleBrown" Margin="10"/>
                    <TextBlock Width="80" Height="20" x:Name="wins" 
FontSize="15"
FontFamily="Comic Sans MS"
TextWrapping="Wrap"
MaxHeight="60"
Foreground="Black"/>
                </StackPanel>

            </StackPanel>

            <StackPanel Width="400">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Username" FontSize="15"
FontFamily="Comic Sans MS" Foreground="SaddleBrown" Margin="10"/>
                    <TextBlock Width="140" Height="20" Margin="5,0,0,0" x:Name="username" FontSize="15"
FontFamily="Comic Sans MS"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
            Margin="10,5,0,5">

                    <TextBlock Text="Status"
               FontSize="15"
               FontFamily="Comic Sans MS"
               Foreground="SaddleBrown"
               Width="70"/>

                    <TextBlock x:Name="status"
                               Margin="14,0,0,0"
               Width="250"
               FontSize="15"
               FontFamily="Comic Sans MS"
               TextWrapping="Wrap"
               MaxHeight="60"
               Foreground="Black"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Top rating" FontSize="15"
FontFamily="Comic Sans MS" Foreground="SaddleBrown" Margin="10"/>
                    <TextBlock Width="80" Height="20" Margin="5,0,0,0"/>
                </StackPanel>

            </StackPanel>
            <StackPanel Width="336" Height="526">
                <Button Content="Create room" Width="267" Height="48" FontSize="22"
                    Margin="20,80,20,40"
                    FontFamily="Comic Sans MS"
                    Foreground="#6F4E37" Background="White" Opacity="0.7" Click="CreateRoom_Click" RenderTransformOrigin="0.497,0.518"/>
                <TextBlock x:Name="CreateRoomError"
               Foreground="Red"
               FontSize="12"
               Visibility="Collapsed"
               Margin="20,2,20,40"/>
                <TextBox Width="260" Height="35"  VerticalContentAlignment="Center" x:Name="RoomCode"/>
                <Button Content="Connect room" Width="267" Height="48" FontSize="22"
                    Margin="20,10,20,20"
                    FontFamily="Comic Sans MS"
                    Foreground="#6F4E37" Background="White" Opacity="0.7" Click="ConnectRoom_Click"/>
                <TextBlock x:Name="ConnectRoomError"
                    Foreground="Red"
                    FontSize="12"
                    Visibility="Collapsed"
                    Margin="20,2,20,40"/>
                <Button Content="Log out |->" Width="267" Height="48" FontSize="22" Margin="20,60,20,20"
FontFamily="Comic Sans MS" 
Foreground="#6F4E37" Background="White" Opacity="0.7" Click="LogOut_Click"/>

            </StackPanel>

        </StackPanel>
        <Image Source="Images/Cute_girl.jpg" Margin="196,297,412,87" RenderTransformOrigin="0.453,0.601" />
        <Image Source="Images/Cute_cat_7.jpg" Margin="456,395,352,124" RenderTransformOrigin="0.453,0.601" />
        

        <Button Content="Edit profile"
        Width="267"
        Height="48"
        FontSize="22"
        FontFamily="Comic Sans MS"
        Foreground="#6F4E37"
        Background="White"
        Opacity="0.7"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="37,423,0,0"
        Click="Edit_Click"/>
        
        <Button Content="View statistics"
        Width="267"
        Height="48"
        FontSize="22"
        FontFamily="Comic Sans MS"
        Foreground="#6F4E37"
        Background="White"
        Opacity="0.7"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="37,512,0,0"/>

    </Grid>
</Window>