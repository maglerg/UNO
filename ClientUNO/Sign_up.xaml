<Window x:Class="ClientUNO.SignUp"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:local="clr-namespace:ClientUNO"
       mc:Ignorable="d"
       Title="SingUp" Height="345" Width="510">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           CornerRadius="25"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="Images/beige.jpg"/>
    </Window.Background>
    <Grid>
        <TextBlock Text="Sign up"
      FontSize="30"
      FontFamily="Comic Sans MS"
      FontWeight="Bold"
      Foreground="White"
      Margin="-2,15,0,0"
      HorizontalAlignment="Center"/>

        <TextBlock Text="Sign up"
      FontSize="30"
      FontFamily="Comic Sans MS"
      FontWeight="Bold"
      Foreground="White"
      Margin="2,15,0,0"
      HorizontalAlignment="Center"/>

        <TextBlock Text="Sign up"
      FontSize="30"
      FontFamily="Comic Sans MS"
      FontWeight="Bold"
      Foreground="White"
      Margin="0,13,0,0"
      HorizontalAlignment="Center"/>

        <TextBlock Text="Sign up"
      FontSize="30"
      FontFamily="Comic Sans MS"
      FontWeight="Bold"
      Foreground="White"
      Margin="0,17,0,0"
      HorizontalAlignment="Center"/>

        <TextBlock Text="Sign up"
      FontSize="30"
      FontFamily="Comic Sans MS"
      FontWeight="Bold"
      Foreground="SaddleBrown"
      Margin="0,15,0,0"
      HorizontalAlignment="Center"/>

        <StackPanel Margin="30,70,0,0" >
            <StackPanel Margin="10">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Enter your username"
                  FontFamily="Comic Sans MS"
                  Foreground="SaddleBrown"
                  Width="168"
                  FontSize="15"/>

                    <TextBox Width="259" x:Name="UsernameBox"
                Height="28"
                VerticalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="UsernameError"
              Foreground="Red"
              FontSize="12"
              Visibility="Collapsed"
              Margin="168,2,0,0"/>
            </StackPanel>
            <StackPanel Margin="10">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Enter the password"
                  FontFamily="Comic Sans MS"
                  Foreground="SaddleBrown"
                  Width="168"
                  FontSize="15"/>

                    <PasswordBox Width="259" x:Name="Password1"
                    Height="28"
                    VerticalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="PasswordError1"
              Foreground="Red"
              FontSize="12"
              Visibility="Collapsed"
              Margin="168,2,0,0"/>
            </StackPanel>
            <StackPanel Margin="10">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Repeat the password"
                  FontFamily="Comic Sans MS"
                  Foreground="SaddleBrown"
                  Width="168"
                  FontSize="15"/>

                    <PasswordBox Width="259" x:Name="Password2"
                    Height="28"
                    VerticalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="PasswordError"
              Foreground="Red"
              FontSize="12"
              Visibility="Collapsed"
              Margin="168,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Content="Sign up" Width="150" Height="40" FontSize="15" Margin="30,10,50,10"
       FontFamily="Comic Sans MS"
       Foreground="#6F4E37" Background="White" Opacity="0.7" Click="SignUp_Click"/>
                <Button Content="Undo" Width="150" Height="40" FontSize="15" Margin="10"
FontFamily="Comic Sans MS"
Foreground="#6F4E37" Background="White" Opacity="0.7" Click="Undo_Click"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
